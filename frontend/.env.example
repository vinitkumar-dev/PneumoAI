# =====================================================
# PneumoAI Frontend — Environment Variables
# =====================================================
# Copy this file to ".env" for local development, or set this as an
# Environment Variable in your Render Static Site settings (must be
# set at BUILD time since Vite inlines it into the bundle).

# Base URL of the deployed backend API (no trailing slash).
VITE_API_URL=http://localhost:5000
