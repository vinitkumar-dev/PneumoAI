# =====================================================
# PneumoAI Backend — Environment Variables
# =====================================================
# Copy this file to ".env" for local development, or set these as
# Environment Variables in your Render Web Service settings.
# NEVER commit a real ".env" file with real secrets.

# -----------------------------------------------------
# Flask
# -----------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
FLASK_ENV=production

# -----------------------------------------------------
# JWT
# -----------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# -----------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pneumo_ai

# -----------------------------------------------------
# CORS
# -----------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Include your local dev URL and your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# -----------------------------------------------------
# Public Base URL (optional)
# -----------------------------------------------------
# Only needed if this API is served from behind a proxy/CDN where the
# public URL differs from the internal request host. Leave blank to let
# the app infer it automatically from each incoming request (recommended
# for both local dev and a standard Render Web Service).
BASE_URL=

# -----------------------------------------------------
# Google Gemini (AI Chat Assistant)
# -----------------------------------------------------
GEMINI_API_KEY=
